{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xinglan.example/schemas/knowledge_metadata.schema.json",
  "title": "Xinglan Knowledge Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_id", "title", "company", "domain", "knowledge_type", "version", "status", "priority", "authority_level", "source_type", "source_authority", "normative_force", "applicability", "source_ids", "source_strategy", "required_source_categories", "minimum_source_count", "synthetic_fields", "parent_knowledge", "depends_on", "dependency_rationale", "applicable_scope", "served_agents", "business_chain_stage", "confidentiality"],
  "properties": {
    "knowledge_id": {"type": "string", "pattern": "^(KB|REF|POL|SOP|FAQ|ROLE|CASE|P[0-9]{3}_[0-9]{2}|TPL|DATA)[A-Z0-9_-]*$"},
    "title": {"type": "string", "minLength": 1},
    "company": {"const": "星澜数字科技有限公司"},
    "domain": {"type": "string", "minLength": 1},
    "knowledge_type": {"enum": ["ENTERPRISE_FOUNDATION", "PUBLIC_REFERENCE", "POLICY", "SOP", "FAQ_RULE", "ROLE", "PROJECT_CASE", "TEMPLATE", "BUSINESS_DATA"]},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "active", "deprecated", "archived"]},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "authority_level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "source_type": {"enum": ["PUBLIC_OFFICIAL", "PUBLIC_CORPORATE", "PUBLIC_CASE", "SYNTHETIC_DERIVED", "SYNTHETIC", "INTERNAL_DERIVED"]},
    "source_authority": {"enum": ["OFFICIAL", "PUBLIC_CORPORATE", "PUBLIC_CASE", "SYNTHETIC_DERIVED", "SYNTHETIC", "INTERNAL_DERIVED"]},
    "normative_force": {"enum": ["MANDATORY", "CONTRACTUAL", "INTERNAL_MANDATORY", "GUIDANCE", "REFERENCE", "NONE"]},
    "applicability": {"enum": ["DIRECT", "CONDITIONAL", "ANALOGICAL", "NOT_APPLICABLE", "PENDING_REVIEW"]},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"}, "uniqueItems": true},
    "source_strategy": {"type": "string", "minLength": 1},
    "required_source_categories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "minimum_source_count": {"type": "integer", "minimum": 0},
    "parent_knowledge": {"type": "array", "items": {"type": "string", "pattern": "^(KB|REF|POL|SOP|FAQ|ROLE|CASE|P[0-9]{3}_[0-9]{2}|TPL|DATA)[A-Z0-9_-]*$"}, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^(KB|REF|POL|SOP|FAQ|ROLE|CASE|P[0-9]{3}_[0-9]{2}|TPL|DATA)[A-Z0-9_-]*$"}, "uniqueItems": true},
    "dependency_rationale": {"type": "string"},
    "synthetic_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "applicable_scope": {"type": "string", "minLength": 1},
    "served_agents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/agent"}, "uniqueItems": true},
    "business_chain_stage": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^B[0-9]{2}$"}, "uniqueItems": true},
    "confidentiality": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "HIGHLY_SENSITIVE"]}
  },
  "$defs": {"agent": {"enum": ["A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09", "A10", "A11", "A12"]}}
}
